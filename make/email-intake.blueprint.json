{
  "name": "Lead Inbox: Email intake (demo)",
  "flow": [
    {
      "id": 1,
      "module": "google-email:triggerWatchNewEmails",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 12608666,
        "filterType": "gmailSearch",
        "q": "in:inbox -from:me -from:make.com -from:google.com -label:HOT -label:COLD -label:SUPPORT -label:JUNK",
        "markSeen": false,
        "limit": 5,
        "format": "full"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch demo inbox"
        }
      }
    },
    {
      "id": 2,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "PASTE_PROCESS_LEAD_WEBHOOK_URL",
        "method": "post",
        "headers": [
          {
            "name": "X-Webhook-Secret",
            "value": "PASTE_WEBHOOK_SECRET_IN_EDITOR"
          }
        ],
        "timeout": 60,
        "contentType": "json",
        "inputMethod": "dataStructure",
        "shareCookies": false,
        "parseResponse": true,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "bodyDataStructure": 675306,
        "dataStructureBodyContent": {
          "body": "{{1.fullTextBody}}",
          "source": "email",
          "subject": "{{1.subject}}",
          "from_name": "{{1.fromName}}",
          "from_email": "{{1.fromEmail}}",
          "message_id": "{{1.id}}",
          "received_at": "{{formatDate(1.internalDate; \"YYYY-MM-DDTHH:mm:ss[Z]\"; \"UTC\")}}"
        },
        "requestCompressedContent": true
      },
      "onerror": [
        {
          "id": 20,
          "module": "builtin:Break",
          "version": 1,
          "mapper": {
            "count": 3,
            "retry": true,
            "interval": 1
          },
          "parameters": {},
          "metadata": {
            "designer": {
              "x": 300,
              "y": 300
            }
          }
        }
      ],
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Send to Process lead webhook"
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "dlq": true,
      "dataloss": false,
      "maxErrors": 3,
      "autoCommit": true,
      "roundtrips": 1,
      "sequential": false,
      "confidential": false,
      "freshVariables": false,
      "autoCommitTriggerLast": true
    }
  }
}
